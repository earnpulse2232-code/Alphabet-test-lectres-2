        const state = {
            current: 0,
            answers: new Array(QUESTIONS.length).fill(null),
            locked: new Array(QUESTIONS.length).fill(false),
            mode: 'test',
            lang: 'en',
            startTime: null,
            timerInterval: null,
            elapsed: 0
        };

        function $(id) { return document.getElementById(id); }

        function toast(msg) {
            const t = $('toast');
            $('toastText').textContent = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 2000);
        }

        function formatTime(s) {
            const m = Math.floor(s / 60);
            return String(m).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0');
        }

        function startApp(mode) {
            state.mode = mode;
            $('startScreen').classList.add('hidden');
            $('quizApp').classList.remove('hidden');
            state.startTime = Date.now();
            state.timerInterval = setInterval(() => {
                state.elapsed = Math.floor((Date.now() - state.startTime) / 1000);
                $('timerText').textContent = formatTime(state.elapsed);
            }, 1000);
            renderQuestion();
            buildPalette();
        }

        function toggleLang() {
            state.lang = state.lang === 'en' ? 'hi' : 'en';
            renderQuestion();
        }

        function renderQuestion() {
            const i = state.current;
            const q = QUESTIONS[i];
            const isQuiz = state.mode === 'quiz';
            const locked = state.locked[i];
            const userAns = state.answers[i];
            const qTxt = state.lang === 'en' ? q.e : q.h;
            const opts = state.lang === 'en' ? q.oEn : q.oHi;

            let optsHtml = '';
            opts.forEach((opt, idx) => {
                let cls = '', tag = '';
                if (isQuiz && locked) {
                    if (idx === q.a) {
                        cls = 'correct';
                        tag = '<span class="opt-tag">Correct</span>';
                    }
                    if (userAns === idx && idx !== q.a) {
                        cls = 'wrong';
                        tag = '<span class="opt-tag">Your Ans</span>';
                    }
                } else if (userAns === idx) {
                    cls = 'selected';
                }
                optsHtml += `
                    <div class="opt ${cls} ${locked ? 'locked' : ''}" onclick="selectOption(${idx})">
                        <div class="opt-letter">${String.fromCharCode(65 + idx)}</div>
                        <div class="opt-text">${opt}</div>
                        ${tag}
                    </div>
                `;
            });

            const solTxt = state.lang === 'en' ? q.sE : q.sH;
            let solHtml = (isQuiz && locked) ? `
                <div class="sol-box">
                    <div class="sol-head"><i class="fas fa-lightbulb"></i> Explanation</div>
                    <div>${solTxt}</div>
                </div>
            ` : '';

            $('quizMain').innerHTML = `
                <div class="q-card">
                    <div class="q-top">
                        <div class="q-num-badge">Question ${i + 1} of ${QUESTIONS.length}</div>
                        <button class="lang-btn" onclick="toggleLang()">
                            <i class="fas fa-language"></i> ${state.lang === 'en' ? 'हिन्दी' : 'English'}
                        </button>
                    </div>
                    <div class="q-text">${qTxt}</div>
                    <div class="opts">${optsHtml}</div>
                    ${solHtml}
                </div>
            `;

            $('prevBtn').disabled = i === 0;
            $('nextLabel').textContent = i === QUESTIONS.length - 1 ? 'Finish' : 'Next';
            updatePaletteGrid();
        }

        function selectOption(idx) {
            if (state.mode === 'quiz' && state.locked[state.current]) return;
            state.answers[state.current] = idx;
            if (state.mode === 'quiz') {
                state.locked[state.current] = true;
                if (idx === QUESTIONS[state.current].a) {
                    toast('Correct! 🎉');
                } else {
                    toast('Incorrect');
                }
            }
            renderQuestion();
        }

        function prevQuestion() {
            if (state.current > 0) {
                state.current--;
                renderQuestion();
            }
        }

        function nextQuestion() {
            if (state.current < QUESTIONS.length - 1) {
                state.current++;
                renderQuestion();
            } else {
                openSubmitModal();
            }
        }

        function buildPalette() {
            const grid = $('paletteGrid');
            grid.innerHTML = '';
            QUESTIONS.forEach((_, i) => {
                const btn = document.createElement('button');
                btn.className = 'pal-btn';
                btn.id = 'pal-' + i;
                btn.textContent = i + 1;
                btn.onclick = () => {
                    state.current = i;
                    closePalette();
                    renderQuestion();
                };
                grid.appendChild(btn);
            });
            updatePaletteGrid();
        }

        function updatePaletteGrid() {
            QUESTIONS.forEach((_, i) => {
                const btn = $('pal-' + i);
                if (!btn) return;
                btn.className = 'pal-btn';
                if (i === state.current) btn.classList.add('current');
                if (state.answers[i] !== null) btn.classList.add('answered');
            });
        }

        function openPalette() {
            $('paletteDrawer').classList.add('open');$('paletteOverlay').classList.add('open');
        }

        function closePalette() {
            $('paletteDrawer').classList.remove('open');$('paletteOverlay').classList.remove('open');
        }

        function openSubmitModal() {
            const ans = state.answers.filter(a => a !== null).length;
            $('modalAttempted').textContent = ans;
            $('modalUnattempted').textContent = QUESTIONS.length - ans;
            $('submitModal').classList.add('open');
        }

        function closeSubmitModal() {
            $('submitModal').classList.remove('open');
        }

        function confirmSubmit() {
            closeSubmitModal();
            if (state.timerInterval) clearInterval(state.timerInterval);
            let correct = 0, wrong = 0;
            state.answers.forEach((ans, i) => {
                if (ans !== null) {
                    if (ans === QUESTIONS[i].a) correct++;
                    else wrong++;
                }
            });
            $('resultsInner').innerHTML = `
                <h2>Test Completed!</h2>
                <p style="color:var(--text-muted);margin:8px 0;">Total Time: ${formatTime(state.elapsed)}</p>
                <div class="res-score-card">
                    <div class="res-score-val">${correct} / ${QUESTIONS.length}</div>
                    <div>Score</div>
                </div>
                <div class="res-grid">
                    <div class="res-item"><div class="res-item-val" style="color:var(--green)">${correct}</div><div>Correct</div></div>
                    <div class="res-item"><div class="res-item-val" style="color:var(--red)">${wrong}</div><div>Wrong</div></div>
                </div>
                <button class="modal-btn confirm" onclick="location.reload()">Re-attempt</button>
            `;
            $('resultsScreen').classList.add('open');
        }
    </script>
</body>
</html>
